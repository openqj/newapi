{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayHub",
  "version": "0.1.5",
  "identifier": "com.apiassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RelayHub",
        "decorations": false,
        "width": 1200,
        "height": 840,
        "minWidth": 980,
        "minHeight": 840
      },
      {
        "label": "merchant-market",
        "title": "RelayHub 商家信息",
        "url": "/?window=merchant-market",
        "decorations": false,
        "visible": false,
        "width": 340,
        "height": 840,
        "minWidth": 340,
        "minHeight": 640
      },
      {
        "label": "register-account",
        "title": "自动注册站点账号",
        "url": "/?window=register-account",
        "decorations": true,
        "visible": false,
        "width": 420,
        "height": 640,
        "minWidth": 400,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://new.diante.me wss://new.diante.me; media-src 'self'",
      "devCsp": "default-src 'self' http://localhost:1420; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: https: http://localhost:1420; font-src 'self' data:; connect-src 'self' http://localhost:1420 ws://localhost:1420 https://new.diante.me wss://new.diante.me; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["relayhub"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCM0Y0ODQ5MTU4RDAxOUEKUldTYUFZMFZTVWcvYXhMVERpSmJjbjBqRldrSHZ6THBlcndVS1BZYUs0czVPRUVWNFZsLzBDS0gK",
      "endpoints": [
        "https://github.com/openqj/newapi/releases/latest/download/latest.json"
      ]
    }
  }
}
