{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayHub",
  "version": "0.1.5",
  "identifier": "com.apiassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RelayHub",
        "decorations": false,
        "width": 1200,
        "height": 840,
        "minWidth": 980,
        "minHeight": 840
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCM0Y0ODQ5MTU4RDAxOUEKUldTYUFZMFZTVWcvYXhMVERpSmJjbjBqRldrSHZ6THBlcndVS1BZYUs0czVPRUVWNFZsLzBDS0gK",
      "endpoints": [
        "https://github.com/openqj/newapi/releases/latest/download/latest.json"
      ]
    }
  }
}
